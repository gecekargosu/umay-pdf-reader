<?xml version="1.0" encoding="utf-8"?>
<!-- v5.6 — "EN SON OKUNAN" kahraman kartı (çizimdeki gibi).
     Lacivert degrade gövde + turuncu alt çizgi (kitap sırtı hissi). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/umay_hero_end"
                android:startColor="@color/umay_hero_start" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/umay_hero_stroke" />
        </shape>
    </item>
    <!-- Alt vurgu şeridi: "raftaki kitap" hissi -->
    <item
        android:bottom="0dp"
        android:gravity="bottom"
        android:height="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/umay_accent"
                android:startColor="@color/umay_orange" />
            <corners
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="18dp" />
        </shape>
    </item>
</layer-list>
