<?xml version="1.0" encoding="utf-8"?>
<!-- v5.6 — Raf teması "Metal": mavi-gri şerit + mavi sol kenar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/umay_shelf_metal" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/umay_shelf_edge" />
        </shape>
    </item>
    <item android:width="4dp" android:left="0dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/umay_accent" />
            <corners
                android:bottomLeftRadius="10dp"
                android:topLeftRadius="10dp" />
        </shape>
    </item>
</layer-list>
