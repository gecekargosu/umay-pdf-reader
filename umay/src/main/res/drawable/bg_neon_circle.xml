<?xml version="1.0" encoding="utf-8"?>
<!-- v6 — Neon AI rozeti: dış halka (turkuaz parlama) + iç yarı saydam dolgu. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#2200E5FF" />
            <stroke
                android:width="2dp"
                android:color="#6600E5FF" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#1A0B0E14" />
            <stroke
                android:width="1dp"
                android:color="@color/umay_accent" />
        </shape>
    </item>
</layer-list>
