<?xml version="1.0" encoding="utf-8"?>
<!-- v5.18 — Namaz vakitleri: şehir, uyarı aralıkları, bugünün vakitleri -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_root"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingTop="28dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/iptal"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:text="@string/prayer_title"
            android:textColor="@color/umay_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/nextText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_hero_card"
                android:padding="14dp"
                android:text="@string/prayer_next_off"
                android:textColor="@color/umay_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_hero_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/rowOn"
                    style="@style/SettingsRow"
                    android:text="@string/prayer_off" />

                <TextView
                    android:id="@+id/rowCity"
                    style="@style/SettingsRow"
                    android:text="@string/prayer_city" />

                <TextView
                    android:id="@+id/rowPre"
                    style="@style/SettingsRow"
                    android:text="@string/prayer_pre" />

                <TextView
                    android:id="@+id/rowEnd"
                    style="@style/SettingsRow"
                    android:text="@string/prayer_end" />

                <TextView
                    android:id="@+id/rowSound"
                    style="@style/SettingsRow"
                    android:text="@string/prayer_sound_on" />

                <TextView
                    android:id="@+id/rowTest"
                    style="@style/SettingsRow"
                    android:text="@string/prayer_test" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/prayer_today"
                android:textColor="@color/umay_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/timesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_hero_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/cityNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/prayer_note"
                android:textColor="@color/umay_text"
                android:textSize="11sp"
                android:alpha="0.7" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
