<?xml version="1.0" encoding="utf-8"?>
<!-- v24 — Gizli kasa: PIN/parmak izi kapısı + medya rafları
     (Resimler / Videolar / Belgeler / Kitaplar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_root"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="← Geri"
            android:textColor="@color/umay_accent"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="🔐 Gizli Kasa"
            android:textColor="@color/umay_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnVaultLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_secondary"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Kilitle"
            android:textColor="@color/umay_accent"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/vaultStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/umay_text_dim"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/vaultShelves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAddMedia"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="＋ Medya / Belge"
            android:textColor="@color/umay_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAddToVault"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:text="📚 Kitabı Taşı"
            android:textColor="@color/umay_accent"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
