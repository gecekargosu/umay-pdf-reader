<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umay_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Üst bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Geri"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btnBack"
                android:text="@string/ayarlar_baslik"
                android:textColor="@color/umay_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Ses -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ay_ses_secimi"
                android:textColor="@color/umay_text"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/voiceSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ay_okuma_hizi"
                android:textColor="@color/umay_text"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/speedSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ay_tts_motor"
                android:textColor="@color/umay_text"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEdgeVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tts_dogal"
                android:textColor="@color/umay_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tts_dogal_aciklama"
                android:textColor="@color/umay_text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnTestVoice"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/ay_tts_test"
                android:textColor="@color/umay_accent" />
        </LinearLayout>

        <!-- Ekolayzır -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/settingsEqSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ay_eq_baslik"
                android:textColor="@color/umay_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/panel_ekolayzir_ipucu"
                android:textColor="@color/umay_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/settingsEqLowLabel"
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ay_eq_bas"
                    android:textColor="@color/umay_text"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/settingsEqLow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="40"
                    android:progressTint="@color/umay_accent"
                    android:thumbTint="@color/umay_accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/settingsEqMidLabel"
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ay_eq_orta"
                    android:textColor="@color/umay_text"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/settingsEqMid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="40"
                    android:progressTint="@color/umay_accent"
                    android:thumbTint="@color/umay_accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/settingsEqHighLabel"
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ay_eq_tiz"
                    android:textColor="@color/umay_text"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/settingsEqHigh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="40"
                    android:progressTint="@color/umay_accent"
                    android:thumbTint="@color/umay_accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Çeviri -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchTranslate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ay_ceviri"
                android:textColor="@color/umay_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ay_ceviri_aciklama"
                android:textColor="@color/umay_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- AI sohbet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ay_api_baslik"
                android:textColor="@color/umay_text"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="@string/ay_api_key"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/umay_text"
                android:textColorHint="@color/umay_text_dim" />

            <EditText
                android:id="@+id/apiModelInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="@string/ay_api_model"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/umay_text"
                android:textColorHint="@color/umay_text_dim" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ay_api_key_aciklama"
                android:textColor="@color/umay_text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnTestApi"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/ay_api_test"
                android:textColor="@color/umay_accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="@string/ay_kaydet"
                android:textColor="#04121A"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
