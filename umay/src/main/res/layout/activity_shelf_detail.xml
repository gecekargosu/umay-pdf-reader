<?xml version="1.0" encoding="utf-8"?>
<!-- v40 — RAF DETAY SAYFASI.
     Kullanıcı ana ekranda bir rafa dokununca burası açılır:
     • rafın tüm dosyaları kapak resmiyle listelenir
     • dosya boyutu / yüklenme tarihi / bağlı ders / son okuma görünür
     • sıra ▲▼ ile değiştirilir ve kalıcı olur
     • raf boş olsa bile açılır ve "Kaynak ekle" ile dosya eklenebilir -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_root"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/iptal"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/shelfDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="44dp"
            android:layout_toStartOf="@id/btnAdd"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/umay_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/raf_kaynak_ekle"
            android:textColor="@color/umay_orange"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:id="@+id/shelfSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textColor="@color/umay_text_dim"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shelfBookList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/shelfEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/shelfEmptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/raf_bos"
                android:textColor="@color/umay_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shelfEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/raf_bos_ipucu"
                android:textColor="@color/umay_text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnAddEmpty"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_panel"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/dosya_ekle"
                android:textColor="@color/umay_orange"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
