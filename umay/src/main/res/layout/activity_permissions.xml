<?xml version="1.0" encoding="utf-8"?>
<!-- v5.5 (AŞAMA 1) — Bildirim & alarm izin merkezi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_root"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="← Geri"
        android:textColor="@color/umay_accent"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="🔔 Bildirim ve Alarm İzinleri"
        android:textColor="@color/umay_text"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/permStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/umay_text_dim"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/permList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/btnPermTest"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:text="🧪 Test bildirimi + 10 sn sonra alarm"
        android:textColor="@color/umay_on_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
