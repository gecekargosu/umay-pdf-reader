<?xml version="1.0" encoding="utf-8"?>
<!-- v13 (AGENT 22 — A2) — AI çalışma kartı düzenleme diyaloğu -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/flashcard_edit_question"
            android:textColor="@color/umay_text_dim"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="10dp"
            android:textColor="@color/umay_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/flashcard_edit_options"
            android:textColor="@color/umay_text_dim"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editOptionA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="A"
            android:padding="10dp"
            android:textColor="@color/umay_text" />

        <EditText
            android:id="@+id/editOptionB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="B"
            android:padding="10dp"
            android:textColor="@color/umay_text" />

        <EditText
            android:id="@+id/editOptionC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="C"
            android:padding="10dp"
            android:textColor="@color/umay_text" />

        <EditText
            android:id="@+id/editOptionD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="D"
            android:padding="10dp"
            android:textColor="@color/umay_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/flashcard_edit_answer"
            android:textColor="@color/umay_text_dim"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/editAnswer"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/flashcard_edit_explanation"
            android:textColor="@color/umay_text_dim"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="10dp"
            android:textColor="@color/umay_text" />
    </LinearLayout>
</ScrollView>
