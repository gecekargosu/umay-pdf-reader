<?xml version="1.0" encoding="utf-8"?>
<!-- v13 (T9d) — Kullanıcı profili: ad / üniversite / bölüm / sınıf + avatar -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="← Geri"
            android:textColor="@color/umay_accent"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/profile_title"
            android:textColor="@color/umay_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/avatarImage"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_panel"
            android:contentDescription="Avatar"
            android:padding="6dp"
            android:src="@drawable/ic_app" />

        <TextView
            android:id="@+id/btnPickAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="🖼 Avatar seç"
            android:textColor="@color/umay_accent"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ad Soyad"
            android:textColor="@color/umay_text_dim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/inputName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="Öğrenci adı"
            android:inputType="textPersonName"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/umay_text"
            android:textColorHint="@color/umay_text_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Üniversite"
            android:textColor="@color/umay_text_dim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/inputUniversity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="Örn. İstanbul Teknik Üniversitesi"
            android:inputType="textPersonName"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/umay_text"
            android:textColorHint="@color/umay_text_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Bölüm"
            android:textColor="@color/umay_text_dim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/inputDepartment"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="Örn. Bilgisayar Mühendisliği"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/umay_text"
            android:textColorHint="@color/umay_text_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sınıf"
            android:textColor="@color/umay_text_dim"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/classSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <TextView
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="Kaydet"
            android:textColor="@color/umay_on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- v13 (AGENT 22 — A3) — Oturum durumu + Çıkış Yap -->
        <TextView
            android:id="@+id/loginStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/umay_text_dim"
            android:textSize="13sp" />

        <!-- v16 (YENİ GÖREV 8) — E-posta/Şifre + Google giriş bloğu
             (oturum açıkken gizlenir) -->
        <LinearLayout
            android:id="@+id/authBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/inputAuthEmail"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input"
                android:hint="@string/auth_email"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/umay_text"
                android:textColorHint="@color/umay_text_dim" />

            <EditText
                android:id="@+id/inputAuthPassword"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="@string/auth_password"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/umay_text"
                android:textColorHint="@color/umay_text_dim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAuthLogin"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:text="@string/auth_login"
                    android:textColor="@color/umay_on_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAuthRegister"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:gravity="center"
                    android:text="@string/auth_register"
                    android:textColor="@color/umay_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAuthGoogle"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/auth_google"
                android:textColor="@color/umay_accent"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/auth_hint"
                android:textColor="@color/umay_text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:text="@string/logout"
            android:textColor="@color/umay_orange"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Profil bilgileri yalnız bu cihazda saklanır. Arkadaş ekleme / sosyal eşleştirme için sunucu altyapısı gerekir (yol haritasında)."
            android:textColor="@color/umay_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
