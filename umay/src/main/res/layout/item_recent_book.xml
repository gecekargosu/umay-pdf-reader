<?xml version="1.0" encoding="utf-8"?>
<!-- v14 (V5.0 §3) — Son Okunanlar rafı: kompakt kitap kartı (sabit genişlik) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="118dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/recentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:minHeight="36sp"
        android:textColor="@color/umay_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/recentPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/umay_orange"
        android:textSize="11sp" />
</LinearLayout>
