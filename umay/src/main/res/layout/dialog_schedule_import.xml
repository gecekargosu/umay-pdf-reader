<?xml version="1.0" encoding="utf-8"?>
<!-- v7 — Program içe aktarma ÖNİZLEME + DÜZENLEME diyaloğu (ScheduleEditDialog).
     OCR/Gemini Vision sonuçları burada gösterilir; eksik/garip satırlar
     düzeltilir, yeni satır eklenir, sonra tek tuşla programa yazılır. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/importHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/program_onizleme_ipucu"
        android:textColor="@color/umay_text_dim"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/rowsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/btnAddRow"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_button_secondary"
        android:gravity="center"
        android:text="@string/ders_satir_ekle"
        android:textColor="@color/umay_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
