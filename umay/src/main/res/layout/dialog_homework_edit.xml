<?xml version="1.0" encoding="utf-8"?>
<!-- Ödev/proje ekleme diyaloğu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="6dp">

    <EditText
        android:id="@+id/inputTitle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_input"
        android:hint="@string/baslik_etiket"
        android:inputType="text"
        android:maxLength="60"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/umay_text"
        android:textColorHint="@color/umay_text_dim" />

    <EditText
        android:id="@+id/inputDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:gravity="top"
        android:hint="@string/aciklama_etiket"
        android:inputType="textMultiLine"
        android:maxLines="3"
        android:minHeight="72dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:textColor="@color/umay_text"
        android:textColorHint="@color/umay_text_dim" />

    <TextView
        android:id="@+id/btnPickDate"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/umay_accent"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnHwAlarm"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/hw_alarm_on"
        android:textColor="@color/umay_accent"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnHwSave"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:text="@string/kaydet"
        android:textColor="@color/umay_on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
