<?xml version="1.0" encoding="utf-8"?>
<!-- Haftalık ders programı ekranı -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_root"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/iptal"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:text="@string/program_baslik"
            android:textColor="@color/umay_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/hatirlatma_ipucu"
        android:textColor="@color/umay_text_dim"
        android:textSize="12sp" />

    <!-- v5: SCHEDULE_EXACT_ALARM kapalıysa uyarı (SDK 36 denetimi) -->
    <TextView
        android:id="@+id/exactAlarmWarn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:text="@string/tam_alarm_izin_yok"
        android:textColor="@color/umay_orange"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- v16 (YENİ GÖREV 3) — TABLO↔LİSTE seçici KALDIRILDI:
         ekran yalnız Excel matris tablodur (X: Pzt…Cuma, Y: 09:00…19:00). -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- v16 (GÖREV 5) — MATRİS TABLO: yatay kaydınılır
                 (X: Pazartesi…Pazar, Y: 08:00…20:00) -->
            <HorizontalScrollView
                android:id="@+id/scheduleGridScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:id="@+id/scheduleGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/scheduleWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Alt aksiyonlar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:text="@string/program_ice_aktar"
            android:textColor="@color/umay_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAddSlot"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="@string/programa_ekle"
            android:textColor="@color/umay_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDailyHour"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/gunluk_saat"
                android:textColor="@color/umay_accent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnTestNotify"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/test_bildirim"
                android:textColor="@color/umay_text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
