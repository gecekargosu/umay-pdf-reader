<?xml version="1.0" encoding="utf-8"?>
<!-- Ses Renkleri paneli: ses, perde, hazır ayarlar, ekolayzır -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <!-- Ses -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_ses"
            android:textColor="@color/umay_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/voiceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/voiceAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/umay_accent"
                android:text="@string/ses_otomatik"
                android:textColor="@color/umay_text"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/voiceFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:buttonTint="@color/umay_accent"
                android:text="@string/ses_kadin"
                android:textColor="@color/umay_text"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/voiceMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:buttonTint="@color/umay_accent"
                android:text="@string/ses_erkek"
                android:textColor="@color/umay_text"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- Perde -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/panel_perde"
            android:textColor="@color/umay_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pitchValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="1.00"
                android:textColor="@color/umay_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/pitchSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="150"
                android:progress="50"
                android:progressTint="@color/umay_accent"
                android:thumbTint="@color/umay_accent" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/panel_perde_ipucu"
            android:textColor="@color/umay_text_dim"
            android:textSize="11sp" />

        <!-- Hazır ayarlar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/panel_hazir"
            android:textColor="@color/umay_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/presetNatural"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/preset_dogal"
                android:textColor="@color/umay_accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/presetDeep"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/preset_derin"
                android:textColor="@color/umay_accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/presetChild"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/preset_cocuk"
                android:textColor="@color/umay_accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/presetVurgulu"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/preset_vurgulu"
                android:textColor="@color/umay_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Ekolayzır -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/panel_ekolayzir"
            android:textColor="@color/umay_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/panel_ekolayzir_ipucu"
            android:textColor="@color/umay_text_dim"
            android:textSize="11sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/eqSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/panel_ekolayzir_acik"
            android:textColor="@color/umay_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="@string/eq_bas"
                android:textColor="@color/umay_text_dim"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/eqLow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="40"
                android:progress="20"
                android:progressTint="@color/umay_accent"
                android:thumbTint="@color/umay_accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="@string/eq_orta"
                android:textColor="@color/umay_text_dim"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/eqMid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="40"
                android:progress="20"
                android:progressTint="@color/umay_accent"
                android:thumbTint="@color/umay_accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="@string/eq_tiz"
                android:textColor="@color/umay_text_dim"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/eqHigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="40"
                android:progress="20"
                android:progressTint="@color/umay_accent"
                android:thumbTint="@color/umay_accent" />
        </LinearLayout>

        <!-- Kapat -->
        <TextView
            android:id="@+id/btnSoundClose"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="@string/panel_tamam"
            android:textColor="#04121A"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
