<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/umay_bg">

    <!-- Üst bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Geri"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/bookTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:layout_toStartOf="@id/pageIndicator"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/umay_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textColor="@color/umay_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Sayfa görüntüsü -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#060A12">

        <ImageView
            android:id="@+id/pageImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Sayfa"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/pageStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_panel"
            android:padding="12dp"
            android:textColor="@color/umay_text_dim"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Kontrol paneli -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="12dp">

        <!-- Sayfa atlama -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sayfa"
                android:textColor="@color/umay_text_dim" />

            <EditText
                android:id="@+id/pageInput"
                android:layout_width="70dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="5"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/umay_text"
                android:textColorHint="@color/umay_text_dim"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnGoPage"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/sayfaya_git"
                android:textColor="@color/umay_accent"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/pageSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:progressTint="@color/umay_accent"
                android:thumbTint="@color/umay_accent" />
        </LinearLayout>

        <!-- Oynatma tuşları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onceki"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_button_primary"
                android:contentDescription="@string/oynat"
                android:padding="16dp"
                android:src="@drawable/ic_play"
                app:tint="#04121A" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sonraki"
                android:src="@drawable/ic_next" />

            <!-- Hız -->
            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="1.0x"
                android:textColor="@color/umay_accent"
                android:textStyle="bold" />

            <!-- Ses (kadın/erkek) -->
            <TextView
                android:id="@+id/btnVoice"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/ses_otomatik"
                android:textColor="@color/umay_accent" />
        </LinearLayout>

        <!-- Alt satır: uyku, çeviri, sohbet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSleep"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/kapali"
                android:textColor="@color/umay_text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnTranslate"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/cevir_oku"
                android:textColor="@color/umay_text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnChat"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/sohbet"
                android:textColor="@color/umay_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Okunan metin önizleme -->
        <TextView
            android:id="@+id/sentencePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/umay_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
