<?xml version="1.0" encoding="utf-8"?>
<!-- Programa ders ekleme/düzenleme diyaloğu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="6dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ders_sec"
        android:textColor="@color/umay_text_dim"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinCourse"
        android:layout_width="match_parent"
        android:layout_height="46dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/gun_etiket"
        android:textColor="@color/umay_text_dim"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinDay"
        android:layout_width="match_parent"
        android:layout_height="46dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/saat_etiket"
        android:textColor="@color/umay_text_dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnPickTime"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="09:00"
        android:textColor="@color/umay_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ders_suresi_etiket"
        android:textColor="@color/umay_text_dim"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinDuration"
        android:layout_width="match_parent"
        android:layout_height="46dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/derslik_etiket"
        android:textColor="@color/umay_text_dim"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/inputRoom"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_input"
        android:hint="B-204"
        android:inputType="text"
        android:maxLength="30"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/umay_text"
        android:textColorHint="@color/umay_text_dim" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hatirlatma_etiket"
        android:textColor="@color/umay_text_dim"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinRemind"
        android:layout_width="match_parent"
        android:layout_height="46dp" />

    <TextView
        android:id="@+id/btnSlotSave"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:text="@string/kaydet"
        android:textColor="@color/umay_on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
