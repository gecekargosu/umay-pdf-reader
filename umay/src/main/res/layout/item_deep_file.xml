<?xml version="1.0" encoding="utf-8"?>
<!-- v22 (AŞAMA 5.5) — tarama satırı: kapak önizlemesi + tür/boyut/tarih/
     sayfa metadata + durum (eklenmedi / zaten ekli / erişilemiyor).
     Checkbox satır tıklamasıyla değişir (yol bazlı seçim). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <CheckBox
        android:id="@+id/chkFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="56dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/thumbLabel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/umay_panel2"
            android:gravity="center"
            android:textColor="@color/umay_text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/umay_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:textColor="@color/umay_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
