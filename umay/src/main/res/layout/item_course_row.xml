<?xml version="1.0" encoding="utf-8"?>
<!-- v40 — DERS SATIRI: ad + kaynak/sınav sayısı + yaklaşan sınav uyarısı
     (1 haftadan az kaldıysa yanıp söner) + sıra okları. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_panel"
    android:orientation="horizontal"
    android:padding="10dp">

    <View
        android:id="@+id/crAccent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/umay_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/crName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/umay_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/crMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/umay_text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/crAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/umay_orange"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/crUp"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/yukari_tasi"
            android:gravity="center"
            android:text="▲"
            android:textColor="@color/umay_accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/crDown"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/asagi_tasi"
            android:gravity="center"
            android:text="▼"
            android:textColor="@color/umay_accent"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
