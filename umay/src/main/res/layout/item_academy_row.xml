<?xml version="1.0" encoding="utf-8"?>
<!-- Akademik modül ortak satır: başlık + alt bilgi + sağ aksiyon (✕/✓) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/umay_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            android:textColor="@color/umay_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowAction"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/iptal"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/umay_orange"
        android:textSize="17sp" />
</LinearLayout>
