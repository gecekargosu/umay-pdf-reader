<?xml version="1.0" encoding="utf-8"?>
<!-- v24 — Gizli kasa raf kartı: küçük önizleme + ad + tür etiketi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="118dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_panel"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/vaultCardThumb"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:background="@drawable/bg_input"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/vaultCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:maxLines="2"
        android:textColor="@color/umay_text"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/vaultCardBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/umay_accent"
        android:textSize="10sp" />
</LinearLayout>
