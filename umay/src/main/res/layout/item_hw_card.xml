<?xml version="1.0" encoding="utf-8"?>
<!-- v5.7 — Ders içi "ÖDEV & PROJELER" rafının kartı.
     Başlık + teslim tarihi + durum; karta dokun → işlem menüsü. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hwCard"
    android:layout_width="210dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_panel"
    android:clickable="true"
    android:elevation="3dp"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="11dp">

    <TextView
        android:id="@+id/hwState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textColor="@color/umay_orange"
        android:textSize="9.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hwTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/umay_text"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hwDue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/umay_text_dim"
        android:textSize="11sp" />
</LinearLayout>
