<?xml version="1.0" encoding="utf-8"?>
<!-- v11 (GÖREV 1) — Dışarıdan gelen belge için karşılama bottom sheet'i -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open_with_title"
        android:textColor="@color/umay_accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/owTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/umay_text_dim"
        android:textSize="13sp" />

    <!-- v14 (V5.0 §2): Tam ekran görüntülemeden ÖNCE net aktarım sorusu -->
    <TextView
        android:id="@+id/owAsk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ow_ask_import"
        android:textColor="@color/umay_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/owView"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:text="@string/open_with_view"
        android:textColor="@color/umay_on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/owImport"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_secondary"
        android:gravity="center"
        android:text="@string/ow_import_now"
        android:textColor="@color/umay_orange"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/owListen"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_secondary"
        android:gravity="center"
        android:text="@string/open_with_listen"
        android:textColor="@color/umay_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
