<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umay_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Üst bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Geri"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/scanTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:text="@string/tara_baslik"
            android:textColor="@color/umay_accent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:id="@+id/scanHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tara_bos"
        android:textColor="@color/umay_text_dim"
        android:textSize="13sp" />

    <!-- Çekilen sayfalar -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/scanProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/umay_text_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Alt aksiyonlar -->
    <TextView
        android:id="@+id/btnCapture"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:text="@string/tara_cek"
        android:textColor="#04121A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnPdf"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_secondary"
        android:gravity="center"
        android:text="@string/tara_yap"
        android:textColor="@color/umay_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
