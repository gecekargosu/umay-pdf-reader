<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v13 (T9a): DayNight — gündüz values/colors.xml, gece values-night/colors.xml.
         Uygulama varsayılanı GECE'dir (AppCompatDelegate); Ayarlar'dan geçiş yapılır. -->
    <style name="Theme.UmayPdf" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- v5: ANA vurgu sıcak turuncu (butonlar/aktif durumlar), ikincil turkuaz -->
        <item name="colorPrimary">@color/umay_orange</item>
        <item name="colorOnPrimary">@color/umay_bg</item>
        <item name="colorPrimaryContainer">@color/umay_orange_dark</item>
        <item name="colorOnPrimaryContainer">@color/umay_text</item>
        <item name="colorSecondary">@color/umay_orange</item>
        <item name="colorOnSecondary">@color/umay_bg</item>
        <item name="colorTertiary">#A78BFA</item>
        <item name="colorSurface">@color/umay_panel</item>
        <item name="colorOnSurface">@color/umay_text</item>
        <item name="colorSurfaceVariant">@color/umay_panel2</item>
        <item name="colorOnSurfaceVariant">@color/umay_text_dim</item>
        <item name="colorOutline">@color/umay_border</item>
        <item name="android:colorBackground">@color/umay_bg</item>
        <item name="android:windowBackground">@color/umay_bg</item>
        <item name="android:statusBarColor">@color/umay_bg</item>
        <item name="android:navigationBarColor">@color/umay_bg</item>
        <item name="android:textColorPrimary">@color/umay_text</item>
        <item name="android:textColorSecondary">@color/umay_text_dim</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.UmayDialog</item>
    </style>

    <!-- Uygulama diyalogları: yuvarlak, koyu, M3 butonlar -->
    <style name="ThemeOverlay.UmayDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/umay_panel</item>
        <item name="colorOnSurface">@color/umay_text</item>
        <item name="colorPrimary">@color/umay_orange</item>
        <item name="colorOnPrimary">@color/umay_bg</item>
        <item name="buttonBarPositiveButtonStyle">@style/UmayDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/UmayDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/UmayDialogButton</item>
    </style>

    <style name="UmayDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/umay_orange</item>
    </style>

    <!-- Kitaplık kapakları: yuvarlak köşeli, ince çerçeveli -->
    <style name="shape_cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>
</resources>
