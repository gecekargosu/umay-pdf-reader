<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_bg"
    android:keepScreenOn="true">

    <!-- ═══════════════ SCAN LINE ANIMATION ═══════════════ -->
    <View
        android:id="@+id/scanLine"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/jarvis_scan_line"
        android:alpha="0.3"
        android:visibility="visible" />

    <!-- ═══════════════ TOP STATUS BAR ═══════════════ -->
    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:background="#CC0A0E17"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Network Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvNetworkType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📶 ---"
                android:textColor="@color/jarvis_cyan"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvNetworkSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- RAM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvRamStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠 --"
                android:textColor="@color/jarvis_cyan"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvRamDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- / --"
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- CPU -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvCpuStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ --"
                android:textColor="@color/jarvis_cyan"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvCpuCores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="cores"
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Battery -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvBatteryStatusTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋 --"
                android:textColor="@color/jarvis_cyan"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvBatteryTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°C"
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Signal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSignalStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡 --"
                android:textColor="@color/jarvis_cyan"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvSignalDbm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- dBm"
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- DND Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDndStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDndLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sound"
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════ JARVIS CORE ANIMATION ═══════════════ -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieCore"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:lottie_rawRes="@raw/jarvis_core"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.28" />

    <!-- ═══════════════ CLOCK ═══════════════ -->
    <TextView
        android:id="@+id/tvLockTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="--:--"
        android:textColor="@color/white"
        android:textSize="72sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:alpha="0.95"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.48" />

    <!-- Date -->
    <TextView
        android:id="@+id/tvLockDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="---"
        android:textColor="@color/jarvis_text_secondary"
        android:textSize="14sp"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toBottomOf="@id/tvLockTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Day of Week -->
    <TextView
        android:id="@+id/tvLockDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="---"
        android:textColor="@color/jarvis_cyan"
        android:textSize="12sp"
        android:letterSpacing="0.3"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvLockDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp" />

    <!-- ═══════════════ WEATHER PANEL ═══════════════ -->
    <com.jarvis.mobile.views.GlassPanel
        android:id="@+id/weatherPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvLockDay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top row: emoji + temp + feels like -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvWeatherEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWeatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°C"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tvWeatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading..."
                        android:textColor="@color/jarvis_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/tvWeatherFeelsLike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Feels: --°"
                        android:textColor="@color/jarvis_cyan"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvWeatherWind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💨 -- km/h"
                        android:textColor="@color/jarvis_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:background="@color/jarvis_divider" />

            <!-- Bottom row: precipitation, high/low -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWeatherPrecip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💧 --%"
                    android:textColor="@color/jarvis_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvWeatherHighLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H: --° L: --°"
                    android:textColor="@color/jarvis_orange"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>
    </com.jarvis.mobile.views.GlassPanel>

    <!-- ═══════════════ NOTIFICATION PANEL ═══════════════ -->
    <com.jarvis.mobile.views.GlassPanel
        android:id="@+id/notificationPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/weatherPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 BİLDİRİMLER"
                android:textColor="@color/jarvis_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp" />

            <!-- WhatsApp -->
            <LinearLayout
                android:id="@+id/notifWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:visibility="gone">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@color/notification_whatsapp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WhatsApp"
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNotifWhatsappCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 yeni"
                    android:textColor="@color/notification_whatsapp"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Instagram -->
            <LinearLayout
                android:id="@+id/notifInstagram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:visibility="gone">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@color/notification_instagram"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Instagram"
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNotifInstagramCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 yeni"
                    android:textColor="@color/notification_instagram"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Gmail -->
            <LinearLayout
                android:id="@+id/notifGmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:visibility="gone">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@color/notification_gmail"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gmail"
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNotifGmailCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 yeni"
                    android:textColor="@color/notification_gmail"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SMS -->
            <LinearLayout
                android:id="@+id/notifSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:visibility="gone">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@color/notification_sms"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SMS"
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNotifSmsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 yeni"
                    android:textColor="@color/notification_sms"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:id="@+id/notifPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@color/notification_phone"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Telefon"
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNotifPhoneCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 cevapsız"
                    android:textColor="@color/notification_phone"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- No notifications message -->
            <TextView
                android:id="@+id/tvNoNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yeni bildirim yok"
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </com.jarvis.mobile.views.GlassPanel>

    <!-- ═══════════════ MUSIC PLAYER ═══════════════ -->
    <com.jarvis.mobile.views.GlassPanel
        android:id="@+id/musicPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/notificationPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Album Art Placeholder -->
            <View
                android:id="@+id/albumArt"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/card_background_cyan" />

            <!-- Song Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMusicTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvMusicArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="@color/jarvis_text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Seekbar -->
                <SeekBar
                    android:id="@+id/seekBarMusic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progressTint="@color/jarvis_cyan"
                    android:thumbTint="@color/jarvis_cyan" />
            </LinearLayout>

            <!-- Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnMusicPrev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="⏮"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:textColor="@color/jarvis_text_secondary" />

                <TextView
                    android:id="@+id/btnMusicPlay"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="▶"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:textColor="@color/jarvis_cyan" />

                <TextView
                    android:id="@+id/btnMusicNext"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="⏭"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:textColor="@color/jarvis_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </com.jarvis.mobile.views.GlassPanel>

    <!-- ═══════════════ BOTTOM SECTION ═══════════════ -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- JARVIS Mic Button -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieMic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Fingerprint / Touch Sensor -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieFingerprint"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:lottie_rawRes="@raw/fingerprint_scan"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

            <TextView
                android:id="@+id/tvFingerprintLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◉ TOUCH SENSOR"
                android:textColor="@color/jarvis_cyan"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Swipe hint -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yukarı kaydırarak kilidi aç"
            android:textColor="@color/jarvis_dim_text"
            android:textSize="10sp"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- ═══════════════ NOTIFICATION PULSE LOTTIE ═══════════════ -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieNotifPulse"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
